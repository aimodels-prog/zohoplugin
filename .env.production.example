# Docker Compose production configuration. Use a Zoho Server-based Application.
PUBLIC_URL=https://books-mcp.via-int.com
POSTGRES_PASSWORD=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# Required: 64 random hex characters; preserve across all redeployments.
TOKEN_ENCRYPTION_KEY=
ALLOWED_EMAIL_DOMAINS=via-int.com
ZOHO_READ_ONLY=true
ZOHO_AUTH_BASE=https://accounts.zoho.com
TRUST_PROXY_HOPS=1
MAX_RESPONSE_CHARS=60000
MAX_REPORT_RECORDS=100000
# Set to the deployed git commit identifier.
BUILD_ID=development
