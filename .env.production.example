# Copy to .env on the Contabo server:  cp .env.production.example .env
# Then fill in every value. Docker Compose reads this file automatically.

# ---- Your domain ----
# The subdomain pointed at this server's IP. No https://, no trailing slash.
DOMAIN=books-mcp.via-int.com

# Same host, with the scheme. Must match DOMAIN exactly.
PUBLIC_URL=https://books-mcp.via-int.com

# ---- Database ----
# Any long random string. Generate one with:
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# ---- Zoho application (from https://api-console.zoho.com) ----
# The Authorized Redirect URI registered there must be exactly:
#   https://books-mcp.via-int.com/zoho/callback
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=

# ---- Access control ----
# Comma-separated email domains allowed to link a Zoho account.
ALLOWED_EMAIL_DOMAINS=via-int.com

# ---- Optional ----
ZOHO_READ_ONLY=false
MAX_RESPONSE_CHARS=60000
