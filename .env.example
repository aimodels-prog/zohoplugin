# ---- Zoho application credentials ----
# From the Zoho API Console, client type "Server-based Application".
# NOT a Self Client — that only works for a single account.
# Authorized Redirect URI must be exactly:  <PUBLIC_URL>/zoho/callback
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=

# ---- Deployment ----
# This server's own public HTTPS URL, no trailing slash.
PUBLIC_URL=

# Postgres. Railway injects this automatically when you attach a Postgres service.
DATABASE_URL=

# ---- Access control ----
# Comma-separated email domains allowed to link an account. Leave blank to allow anyone
# who finds the URL to connect their own Zoho account (they still only see their own data,
# but they would be using your server as free infrastructure).
ALLOWED_EMAIL_DOMAINS=via-int.com

# ---- Optional ----
# true hides all create/update/delete tools, leaving the 30 read-only tools.
ZOHO_READ_ONLY=false

# Truncate very large API responses so they fit in the model's context.
MAX_RESPONSE_CHARS=60000

# Port. Hosting platforms set this automatically — leave it alone in production.
PORT=8080
