# Node 22+, PostgreSQL, and a Zoho Server-based Application.
# Registered Zoho redirect URI: PUBLIC_URL + /zoho/callback
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
PUBLIC_URL=https://books-mcp.example.com
DATABASE_URL=postgres://zoho:CHANGE_ME@localhost:5432/zoho_books
DATABASE_SSL=false

# Required, persistent 32-byte encryption key (64 hex characters).
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Back this up separately from the database. Do not regenerate on redeploy.
TOKEN_ENCRYPTION_KEY=

ALLOWED_EMAIL_DOMAINS=via-int.com
# Read-only by default. Set false only to enable preview/confirmation write tools.
ZOHO_READ_ONLY=true
ZOHO_AUTH_BASE=https://accounts.zoho.com
PORT=8080
TRUST_PROXY_HOPS=1
BUILD_ID=development
MAX_RESPONSE_CHARS=60000
MAX_REPORT_RECORDS=100000
HTTP_TIMEOUT_MS=20000
MAX_API_BYTES=8000000
# For managed PostgreSQL use DATABASE_SSL=true and a trusted CA when required.
# DATABASE_CA_PEM=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
