# Caddy obtains and renews the Let's Encrypt certificate automatically.
# Requires: DNS for {$DOMAIN} points at this server, and ports 80 + 443 are reachable.

{$DOMAIN} {
	encode gzip

	reverse_proxy zoho-mcp-app:8080

	log {
		output stdout
		format filter {
			request>uri query {
				delete code
				delete state
				delete client_secret
			}
			request>headers>Authorization delete
			request>headers>Cookie delete
			wrap json
		}
	}
}
